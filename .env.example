# Copy this file to .env (not tracked by git). What to run is set in config.yaml, not here.

# Our server: only needed to download a prepared step (data.start_with) or the raw month (data.raw_from: server).
LICHESS_S3_ENDPOINT=https://lichess-data.sandouk.net
LICHESS_S3_BUCKET=lichess
LICHESS_S3_ACCESS_KEY=
LICHESS_S3_SECRET_KEY=

# Optional: a folder on this computer that already holds the raw monthly file (same name as on Lichess).
LICHESS_LOCAL_DIR=

# Optional: the Stockfish program, only for data.stockfish: compute.
STOCKFISH_PATH=
