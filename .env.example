# Access to the team's read-only copy of the raw Lichess files (S3). Copy this file to .env and fill in the
# two keys (ask Laith). .env is not tracked by git.
LICHESS_S3_ENDPOINT=https://lichess-data.sandouk.net
LICHESS_S3_BUCKET=lichess
LICHESS_S3_ACCESS_KEY=
LICHESS_S3_SECRET_KEY=

# A folder that already holds the monthly file (same name as on Lichess), e.g. D:/2_UNI/Data Mining/lichess-raw.
# If the file is there, it is read instead of the S3 copy, and the S3 keys are not needed.
LICHESS_LOCAL_DIR=

# Stockfish for the engine features (src/02_preprocessing/with_stockfish/engine.py; only needed to run Stockfish yourself): the program file, e.g.
# C:/tools/stockfish/stockfish-windows-x86-64-avx2.exe. Empty: engine.path of config.yaml (a name on PATH).
STOCKFISH_PATH=
