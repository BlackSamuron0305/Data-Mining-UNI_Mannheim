<mxfile><diagram name="Selection and split"><mxGraphModel adaptiveColors="auto"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="month" value="&lt;b&gt;Complete games&lt;/b&gt;&lt;br&gt;of the month; a&lt;br&gt;random tenth&lt;br&gt;kept as pool" style="shape=cylinder3;boundedLbl=1;size=8;whiteSpace=wrap;html=1;fillColor=#F3EEFF;strokeColor=#B9A6F0;fontColor=#1B1F24;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="0" y="20" width="104" height="84" as="geometry"/></mxCell><mxCell id="draw" value="&lt;b&gt;Stratified draw&lt;/b&gt;&lt;br&gt;350,000 games;&lt;br&gt;each of 28 groups&lt;br&gt;gets its share" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EEF4FF;strokeColor=#9DB8F2;fontColor=#1B1F24;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="130" y="28" width="112" height="68" as="geometry"/></mxCell><mxCell id="test" value="&lt;b&gt;Test games&lt;/b&gt; (20 % per group)&lt;br&gt;balanced to the month" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF6E0;strokeColor=#E8C36A;fontColor=#1B1F24;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="280" y="0" width="160" height="42" as="geometry"/></mxCell><mxCell id="train" value="&lt;b&gt;Training games&lt;/b&gt; (80 %)&lt;br&gt;10 % are validation games" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EEF4FF;strokeColor=#9DB8F2;fontColor=#1B1F24;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="280" y="82" width="160" height="42" as="geometry"/></mxCell><mxCell id="score" value="&lt;b&gt;Scored once&lt;/b&gt;, the same&lt;br&gt;games for both runs" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E7F6EC;strokeColor=#8BCB9F;fontColor=#1B1F24;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="474" y="0" width="156" height="42" as="geometry"/></mxCell><mxCell id="runs" value="&lt;b&gt;Stratified run&lt;/b&gt;: as drawn&lt;br&gt;&lt;b&gt;Balanced run&lt;/b&gt;: balanced" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EEF4FF;strokeColor=#9DB8F2;fontColor=#1B1F24;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="474" y="82" width="156" height="42" as="geometry"/></mxCell><mxCell id="a1" style="endArrow=block;endSize=5;html=1;strokeColor=#8A94A6;" edge="1" parent="1" source="month" target="draw"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="a2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;endSize=5;html=1;strokeColor=#8A94A6;exitX=0.5;exitY=0;entryX=0;entryY=0.5;" edge="1" parent="1" source="draw" target="test"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="a3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;endSize=5;html=1;strokeColor=#8A94A6;exitX=0.5;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="draw" target="train"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="a4" style="endArrow=block;endSize=5;html=1;strokeColor=#8A94A6;" edge="1" parent="1" source="test" target="score"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="a5" style="endArrow=block;endSize=5;html=1;strokeColor=#8A94A6;" edge="1" parent="1" source="train" target="runs"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="a6" value="models" style="dashed=1;endArrow=block;endSize=5;html=1;strokeColor=#8A94A6;fontColor=#5A626E;fontFamily=Helvetica;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="runs" target="score"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
