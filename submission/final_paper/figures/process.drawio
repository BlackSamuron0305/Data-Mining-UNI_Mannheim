<mxfile><diagram name="Process"><mxGraphModel adaptiveColors="auto"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="s1" value="&lt;b&gt;1 Selection&lt;/b&gt;&lt;br&gt;89.6 M games&lt;br&gt;→ complete cases&lt;br&gt;→ 350,000 drawn" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EEF4FF;strokeColor=#9DB8F2;fontColor=#1B1F24;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="110" height="74" as="geometry"/></mxCell><mxCell id="s2" value="&lt;b&gt;2 Preprocessing&lt;/b&gt;&lt;br&gt;one row per move&lt;br&gt;38 features&lt;br&gt;+ Stockfish" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EEF4FF;strokeColor=#9DB8F2;fontColor=#1B1F24;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="128" y="0" width="110" height="74" as="geometry"/></mxCell><mxCell id="s3" value="&lt;b&gt;3 Transformation&lt;/b&gt;&lt;br&gt;fixed tables&lt;br&gt;validation games&lt;br&gt;model encodings" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EEF4FF;strokeColor=#9DB8F2;fontColor=#1B1F24;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="256" y="0" width="110" height="74" as="geometry"/></mxCell><mxCell id="s4" value="&lt;b&gt;4 Data mining&lt;/b&gt;&lt;br&gt;6 baselines&lt;br&gt;8 learners&lt;br&gt;Bayesian tuning" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EEF4FF;strokeColor=#9DB8F2;fontColor=#1B1F24;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="384" y="0" width="110" height="74" as="geometry"/></mxCell><mxCell id="s5" value="&lt;b&gt;5 Evaluation&lt;/b&gt;&lt;br&gt;test games, once&lt;br&gt;scores, errors&lt;br&gt;feature groups" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E7F6EC;strokeColor=#8BCB9F;fontColor=#1B1F24;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="512" y="0" width="110" height="74" as="geometry"/></mxCell><mxCell id="e1" style="endArrow=block;endSize=5;html=1