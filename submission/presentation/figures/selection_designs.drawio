<mxfile><diagram name="Selection designs"><mxGraphModel adaptiveColors="auto"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="title" value="Which games? Three ways to draw 350,000 games" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;fontFamily=Helvetica;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="700" height="36" as="geometry"/></mxCell>
<mxCell id="src" value="&lt;b&gt;Complete games of September 2026&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;8,706,789 games · 28 groups = 4 speeds × 7 rating bands&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#1E3A8A;strokeColor=none;fontColor=#FFFFFF;fontSize=15;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="250" y="52" width="520" height="62" as="geometry"/></mxCell>
<mxCell id="cR" value="Fully random" style="swimlane;startSize=38;rounded=1;arcSize=4;html=1;fillColor=#F8FAFC;swimlaneFillColor=#F8FAFC;strokeColor=#94A3B8;strokeWidth=2;fontSize=16;fontStyle=1;fontColor=#334155;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="0" y="150" width="320" height="325" as="geometry"/></mxCell>
<mxCell id="cA" value="Stratified random · stratified run" style="swimlane;startSize=38;rounded=1;arcSize=4;html=1;fillColor=#EFF6FF;swimlaneFillColor=#F8FAFC;strokeColor=#2563EB;strokeWidth=2;fontSize=16;fontStyle=1;fontColor=#1E3A8A;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="350" y="150" width="320" height="325" as="geometry"/></mxCell>
<mxCell id="cB" value="Stratified + balanced · balanced run" style="swimlane;startSize=38;rounded=1;arcSize=4;html=1;fillColor=#F0FDF4;swimlaneFillColor=#F8FAFC;strokeColor=#16A34A;strokeWidth=2;fontSize=16;fontStyle=1;fontColor=#14532D;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="700" y="150" width="320" height="325" as="geometry"/></mxCell>
<mxCell id="sR" value="every complete game has the same chance" style="text;html=1;align=center;fontSize=13;fontStyle=2;fontColor=#475569;fontFamily=Helvetica;" vertex="1" parent="cR"><mxGeometry x="10" y="44" width="300" height="28" as="geometry"/></mxCell>
