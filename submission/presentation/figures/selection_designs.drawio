<mxCell id="tR" value="&lt;b&gt;Fixes:&lt;/b&gt; nothing&lt;br&gt;&lt;b&gt;Risk:&lt;/b&gt; rare groups (e.g. classical 2000+) drift from the month by chance&lt;br&gt;&lt;b&gt;Used as:&lt;/b&gt; yardstick only" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=13;fontColor=#0F172A;spacing=0;fontFamily=Helvetica;" vertex="1" parent="cR"><mxGeometry x="20" y="200" width="280" height="120" as="geometry"/></mxCell>
<mxCell id="tA" value="&lt;b&gt;Fixes:&lt;/b&gt; every group gets exactly its share of the month&lt;br&gt;&lt;b&gt;Check:&lt;/b&gt; as close to the month as a random draw can be (χ² 1,034, chance range 877–1,095)&lt;br&gt;&lt;b&gt;Used as:&lt;/b&gt; the stratified run, the main pipeline" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=13;fontColor=#0F172A;spacing=0;fontFamily=Helvetica;" vertex="1" parent="cA"><mxGeometry x="20" y="200" width="280" height="120" as="geometry"/></mxCell>
<mxCell id="tB" value="&lt;b&gt;Fixes:&lt;/b&gt; also the blunder rate of all 756 buckets&lt;br&gt;&lt;b&gt;How:&lt;/b&gt; 18,352 of 280,002 training games swapped (6.6%), χ² 30&lt;br&gt;&lt;b&gt;Risk:&lt;/b&gt; picks games by their label, so it keeps calmer games&lt;br&gt;&lt;b&gt;Used as:&lt;/b&gt; the balanced run, training games only" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=13;fontColor=#0F172A;spacing=0;fontFamily=Helvetica;" vertex="1" parent="cB"><mxGeometry x="20" y="200" width="280" height="120" as="geometry"/></mxCell>
<mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=1.5;" edge="1" parent="1" source="src" target="cR"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=1.5;" edge="1" parent="1" source="src" target="cA"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=1.5;" edge="1" parent="1" source="src" target="cB"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="test" value="&lt;b&gt;The same 69,998 test games&lt;/b&gt; (20% of every group) for the stratified and the balanced run&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;so both are scored on identical games: a fair test of whether balancing helps&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E3A8A;strokeWidth=2;fontColor=#0F172A;fontSize=15;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="350" y="515" width="670" height="64" as="geometry"/></mxCell>
<mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#2563EB;strokeWidth=1.5;" edge="1" parent="1" source="cA" target="test"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#16A34A;strokeWidth=1.5;" edge="1" parent="1" source="cB" target="test"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="legend" value="&lt;b&gt;Bars:&lt;/b&gt; share of six example groups in the selection&lt;br&gt;&lt;b&gt;Dashed outline:&lt;/b&gt; the group's share in the month&lt;br&gt;&lt;b&gt;Red top:&lt;/b&gt; blunder rate, matched to the month" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontColor=#475569;spacing=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="0" y="515" width="320" height="64" as="geometry"/></mxCell>
